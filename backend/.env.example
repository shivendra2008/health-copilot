# ---- Server
APP_ENV=development
# Comma-separated list of allowed browser origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000

# ---- Supabase (Project Settings → API). SERVICE ROLE KEY IS SECRET: backend only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
STORAGE_BUCKET=medical-documents
SIGNED_URL_TTL_SECONDS=120
DB_TIMEOUT_SECONDS=15

# ---- Groq (https://console.groq.com/keys). SECRET: backend only.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
LLM_MAX_INPUT_CHARS=24000

# ---- Uploads & OCR
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
OCR_ENABLED=true
OCR_LANG=en
OCR_DPI=200
OCR_CPU_THREADS=2

# ---- Rate limits (per user per window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOADS=10
RATE_LIMIT_PROCESSING=10
RATE_LIMIT_CHAT=20
